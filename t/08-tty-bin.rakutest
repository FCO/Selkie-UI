use Test;
use Selkie::UI::Test::TTY;

plan *;

if %*ENV<CI> || %*ENV<GITHUB_ACTIONS> {
    plan 1;
    skip 'TTY tests require a real terminal (not available in CI)';
    done-testing;
    exit;
}

# 1 — selkie-ui-playground
subtest 'selkie-ui-playground' => {
    my $tty = Selkie::UI::Test::TTY.new(:script<bin/selkie-ui-playground.raku>);
    if !$tty.verify {
        plan 1;
        skip 'TTY interaction not available (PTY may not support TUI rendering)';
        done-testing;
        return;
    }
    plan 6;
    ok $tty.ready, 'Playground script started';

    $tty.send-text('say "hello from test"');
    sleep 1;
    ok $tty.is-alive, 'Playground: code entered alive';

    sleep 1;
    ok $tty.is-alive, 'Playground: still alive';

    $tty.quit;
    sleep 1;
    nok $tty.is-alive, 'Playground script terminated';
    is $tty.exitcode, 0, 'Playground exited with code 0';
    is $tty.stderr, '', 'Playground produced no stderr';
    $tty.cleanup;
}

# 2 — selkie-ui-grammar-playground
subtest 'selkie-ui-grammar-playground' => {
    my $tty = Selkie::UI::Test::TTY.new(:script<bin/selkie-ui-grammar-playground.raku>);
    if !$tty.verify {
        plan 1;
        skip 'TTY interaction not available (PTY may not support TUI rendering)';
        done-testing;
        return;
    }
    plan 6;
    ok $tty.ready, 'Grammar playground script started';

    sleep 2;
    ok $tty.is-alive, 'Grammar playground: initialized alive';

    $tty.send-key('ctrl+enter');
    sleep 0.5;
    ok $tty.is-alive, 'Grammar playground: compile alive';

    $tty.quit;
    sleep 1;
    nok $tty.is-alive, 'Grammar playground script terminated';
    is $tty.exitcode, 0, 'Grammar playground exited with code 0';
    is $tty.stderr, '', 'Grammar playground produced no stderr';
    $tty.cleanup;
}

done-testing;
