use Test;

my @examples = <
    examples/charts.raku
    examples/chat.raku
    examples/counter.raku
    examples/dashboard.raku
    examples/file-viewer.raku
    examples/job-runner.raku
    examples/settings.raku
    examples/tasks.raku
    examples/text.raku
    examples/test.raku
>;

plan 2;

subtest 'examples compile' => {
    plan @examples.elems;
    for @examples -> $path {
        my $proc = run 'raku', '-I', 'lib', '-c', $path, :out, :err;
        $proc.out.close;
        my $err = $proc.err.slurp-rest;
        $proc.err.close;
        is $proc.exitcode, 0, "$path compiles";
    }
}

subtest 'examples compile without warnings' => {
    plan @examples.elems;
    for @examples -> $path {
        my $proc = run 'raku', '-I', 'lib', '-c', $path, :out, :err;
        $proc.out.close;
        my $err = $proc.err.slurp-rest;
        $proc.err.close;
        ok !$err.contains('WARNING') && !$err.contains('ERROR'), "$path has no warnings";
    }
}

done-testing;
