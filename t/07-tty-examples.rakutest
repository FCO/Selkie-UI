use Test;
use Selkie::UI::Test::TTY;

plan *;

if %*ENV<CI> || %*ENV<GITHUB_ACTIONS> {
    plan 1;
    skip 'TTY tests require a real terminal (not available in CI)';
    done-testing;
    exit;
}

# 1 — Counter
subtest 'Counter example' => {
    my $tty = Selkie::UI::Test::TTY.new(:script<examples/counter.raku>);
    if !$tty.verify {
        plan 1;
        skip 'TTY interaction not available (PTY may not support TUI rendering)';
        done-testing;
        return;
    }
    plan 7;
    ok $tty.ready, 'Counter script started';

    $tty.send-key('tab');
    $tty.send-key('enter');
    sleep 0.5;
    ok $tty.is-alive, 'Counter: decrement alive';

    $tty.send-key('tab');
    $tty.send-key('tab');
    $tty.send-key('enter');
    sleep 0.5;
    ok $tty.is-alive, 'Counter: reset alive';

    $tty.send-key('tab');
    $tty.send-key('tab');
    $tty.send-key('tab');
    $tty.send-key('enter');
    sleep 0.5;
    ok $tty.is-alive, 'Counter: increment alive';

    $tty.quit;
    sleep 1;
    nok $tty.is-alive, 'Counter script terminated';
    is $tty.exitcode, 0, 'Counter exited with code 0';
    is $tty.stderr, '', 'Counter produced no stderr';
    $tty.cleanup;
}

# 2 — Tasks
